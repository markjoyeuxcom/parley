# SwiftPM output and per-machine workspace state
native/.build/
native/.swiftpm/

# The Node helper has no dependencies, but ignore accidental local installs
node_modules/

# Future native packaging output
dist/
DerivedData/
*.xcuserstate
xcuserdata/

# Local tool state
.claude/settings.local.json

# Environment files — Parley has no API-key path
.env
.env.*

# Editors, macOS and logs
.DS_Store
.idea/
.vscode/
*.log
