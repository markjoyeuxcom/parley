{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "A native macOS workbench for supervised cross-vendor AI CLI collaboration.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-native-swift.mjs run --package-path native parley-native --cwd .",
    "dev:restart-protocol": "node scripts/run-native-swift.mjs run --package-path native parley-native --cwd . --restart-stale-protocol",
    "test": "node scripts/run-native-swift.mjs run --package-path native parley-native-checks",
    "build": "node scripts/run-native-swift.mjs build --package-path native"
  }
}
